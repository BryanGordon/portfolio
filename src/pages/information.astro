---
import Certifications from '../components/Certifications.astro'
import Layout from '../layouts/Layout.astro'
import CertificationsData from '../mocks/certifications.json'

---
<Layout>
  <section>
    <header>
      <h1>Personal Information</h1>
    </header>

    <article>
      <h2>Experience</h2>

      <div>
        <p class="experience-text">
          <strong>+4 years of experience</strong> development personal projects and working with customers as freelancer.
        </p>
      </div>
    </article>

    <article class="containers-info">
      <h2>Basic information</h2>

      <div class="container-personal">
        <strong>Full name: </strong>
        <p class='answer'>Bryan Armando Gordon Echeverria </p>
      </div>

      <div class="container-personal">
        <strong>Address: </strong>
        <p class='answer'>Cotacachi - Imbabura - Ecuador</p>
      </div>

      <div class="container-personal">
        <strong>Email: </strong>
          <p class='answer highlight'>bryanbge92@gmail.com / bryanbge98@outlook.com</p>
      </div>
    </article>

    <article class="containers-info">
      <h2>Certifications</h2>
      {
        CertificationsData.map((certification) => (
          <Certifications 
          name={certification.name} 
          icon={certification.icon} 
          sizeIcon={certification.sizeIcon} 
          courses={certification.courses} 
          titleSpacing={certification.titleSpacing} 
          containerSpacing={certification.containerSpacing}
          />
        ))
      }
    </article>
  </section>
</Layout>

<style>
  section {
    width: 85%;
    margin: 0 auto;
  }

  div {
    margin-top: 35px;
  }

  h2 {
    text-align: center;
    font-size: 36px;
    color: #ededfce1;
  }

  strong {
    color: #8b8bff;
    font-size: 18px;
  }

  p {
    font-size: 18px;
  }

  .experience-text {
    text-align: center;
  }
  
  .containers-info {
    margin-block: 110px;
    align-items: center;
  }

  .container-personal {
    text-align: center;
  }

  .answer {
    display: inline;
  }

  .highlight {
    font-weight: 600;
  }
</style>